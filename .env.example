# Supabase project that holds blog posts, testimonials and uploaded images.
# Copy to .env.local and fill in from Project Settings > API in the dashboard.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server only. Bypasses row level security, so it must never be prefixed with
# NEXT_PUBLIC_ and never imported from a client component. Used by the daily
# heartbeat route and the one-off seed script.
SUPABASE_SERVICE_ROLE_KEY=

# Any long random string. Vercel Cron sends it as a bearer token to
# /api/heartbeat; the route rejects anything else.
CRON_SECRET=

# Where the site is deployed. Only the seed script uses it, to refresh the
# site's cache after writing rows straight to the database.
SITE_URL=https://your-site.vercel.app

# Shown in the admin when the database cannot be reached, so the site owner can
# resume a paused project. Copy the URL of the project's dashboard page.
NEXT_PUBLIC_SUPABASE_DASHBOARD_URL=https://supabase.com/dashboard/project/your-project-ref
